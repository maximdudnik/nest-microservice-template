# Local development only. Real secrets come from the secret manager (standards §8).
NODE_ENV=development
SERVICE_NAME=orders-service
SERVICE_VERSION=0.1.0
PORT=3000
LOG_LEVEL=debug
LOG_PRETTY=true

DATABASE_URL=postgres://orders:orders@localhost:5432/orders
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=5000

RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_PREFETCH=20

OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=100

# Sample third-party provider (risk scoring) used by CreateOrder
RISK_API_URL=http://localhost:4010
RISK_API_KEY=change-me
RISK_API_TIMEOUT_MS=3000

SHUTDOWN_GRACE_MS=25000

# OpenTelemetry: leave endpoint empty to disable export
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=orders-service
