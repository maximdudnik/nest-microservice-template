{
  "name": "@org/orders-service",
  "version": "0.1.0",
  "private": true,
  "description": "Orders bounded context: NestJS + hexagonal architecture template",
  "engines": {
    "node": ">=24 <25"
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps --require ./dist/instrumentation.js dist/main.js",
    "start:dev": "tsc -p tsconfig.build.json && node --enable-source-maps --env-file-if-exists=.env --require ./dist/instrumentation.js dist/main.js",
    "migrate": "node --env-file-if-exists=.env dist/migrate.js",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0 && depcruise src --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --config jest.config.js",
    "test:cov": "jest --config jest.config.js --coverage",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs"
  },
  "dependencies": {
    "@golevelup/nestjs-rabbitmq": "^9.1.0",
    "@nestjs/common": "^11.1.24",
    "@nestjs/core": "^11.1.24",
    "@nestjs/platform-fastify": "^11.1.24",
    "@nestjs/terminus": "^11.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.81.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@org/contracts": "workspace:*",
    "amqplib": "^0.10.9",
    "cockatiel": "^3.2.1",
    "drizzle-orm": "^0.45.0",
    "nestjs-pino": "^5.3.0",
    "pg": "^8.16.0",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0",
    "fastify": "^5.12.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@nestjs/testing": "^11.1.24",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/amqplib": "^0.10.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-import-resolver-typescript": "^4.4.0",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-import-x": "^4.16.0",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.6.0",
    "testcontainers": "^12.2.0",
    "ts-jest": "^29.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "dependency-cruiser": "~18.6.0"
  }
}
